# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon): use the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mentoros?sslmode=require

# Auth (Better Auth)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth providers. Each one turns on when both values are set.
# Each provider calls back to BETTER_AUTH_URL + /api/auth/callback/<provider>, so register that
# URL for every origin you sign in from (local and live), e.g.
# http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: an OAuth client of type "Web application" in Google Cloud. Authorised redirect URI:
# http://localhost:3000/api/auth/callback/google (plus your live domain's).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (OpenAI via the Vercel AI SDK)
OPENAI_API_KEY=
# Model ids per tier. "fast" for chat, hints and the tutor; "smart" for grading, planning and
# missions; "deep" for writing assessments. Rechecked side by side on 2026-10-21: sol matched astra
# on grading, planning and missions at a fifth of the price, and astra wrote clearly better questions.
AI_MODEL_FAST=gpt-6-luna
AI_MODEL_SMART=gpt-6-sol
AI_MODEL_DEEP=gpt-6-astra

# Reading mission submissions from public GitHub repositories and gists. Optional: without a
# token GitHub allows 60 reads an hour per server. A fine-grained token with no extra permissions
# (public data only) is enough.
GITHUB_TOKEN=

# Email (Resend): account emails (confirm, reset, password changed), weekly progress and
# reminders. Without a key, development prints each email to the server log instead.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. mentorOS <no-reply@your-domain>
EMAIL_FROM=
# Outside production, every email goes here instead of to the learner. delivered@resend.dev is
# Resend's test inbox. Blank prints emails to the server log.
EMAIL_DEV_REDIRECT=
# Vercel Cron sends this as a bearer token to /api/cron/daily. Generate with: openssl rand -base64 32
CRON_SECRET=

# Running learner code (Vercel Sandbox). The snapshot id comes from
# `pnpm exec tsx scripts/build-runner-snapshot.ts`. On Vercel the sandbox signs in with the
# deployment's OIDC token; locally it needs a token from vercel.com/account/tokens plus the
# team id (Team Settings > General) and project id (Project Settings > General).
CODE_RUNNER_SNAPSHOT_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Error monitoring (Sentry). Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics (PostHog). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
