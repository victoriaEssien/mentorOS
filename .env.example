# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon): use the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mentoros?sslmode=require

# Auth (Better Auth)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth providers. Each one turns on when both values are set.
# GitHub callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (OpenAI via the Vercel AI SDK)
OPENAI_API_KEY=
# Model ids per tier. "fast" for chat and hints, "smart" for anything that changes learner state.
# Benchmarked on 2026-10-05: luna is the quickest GPT-6 model, astra the most rigorous.
AI_MODEL_FAST=gpt-6-luna
AI_MODEL_SMART=gpt-6-astra

# Reading mission submissions from public GitHub repositories and gists. Optional: without a
# token GitHub allows 60 reads an hour per server. A fine-grained token with no extra permissions
# (public data only) is enough.
GITHUB_TOKEN=

# Error monitoring (Sentry). Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics (PostHog). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
